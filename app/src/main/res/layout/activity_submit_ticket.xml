<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/submit_ticket_title"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/titleText"
                android:text="@string/submit_ticket_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_bg"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Title -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/submit_ticket_issue_summary_hint"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/primary"
                    app:boxStrokeColor="@color/primary"
                    app:boxBackgroundColor="@color/bg_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ticketTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/submit_ticket_category_hint"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/primary"
                    app:boxStrokeColor="@color/primary"
                    app:boxBackgroundColor="@color/bg_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_marginBottom="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/categoryDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Priority Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/submit_ticket_priority_hint"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/primary"
                    app:boxStrokeColor="@color/primary"
                    app:boxBackgroundColor="@color/bg_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_marginBottom="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/priorityDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- AI Priority Suggestion -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/aiSuggestionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/bg_surface"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/glass_border"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_priority_suggestion_title"
                            android:textColor="@color/secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/aiSuggestionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_priority_suggestion_sample"
                            android:textColor="@color/text_main"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"/>

                        <Button
                            android:id="@+id/applyAiSuggestionButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_apply_suggestion"
                            android:textAllCaps="false"
                            android:textColor="@color/secondary"
                            android:backgroundTint="@color/bg_dark"
                            android:minHeight="0dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/submit_ticket_description_hint"
                    android:textColorHint="@color/text_muted"
                    app:hintTextColor="@color/primary"
                    app:boxStrokeColor="@color/primary"
                    app:boxBackgroundColor="@color/bg_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ticketDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:gravity="top"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Attachments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/submit_ticket_attachments"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/attachmentBox"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/dashed_border"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="24dp">
                    
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_cloud"
                        app:tint="@color/text_muted"/>
                        
                    <TextView
                        android:id="@+id/attachmentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/submit_ticket_attachment_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/submit_ticket_button"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/primary"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
