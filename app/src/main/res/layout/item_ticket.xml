<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/glass_bg"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/ticketTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket Title"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/ticketStatus"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/attachmentIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ticketTitle"
                android:layout_alignParentStart="true"
                android:text="@string/item_ticket_attachment_indicator"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/assignedIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/attachmentIndicator"
                android:layout_alignParentStart="true"
                android:text="@string/assigned_to_you_indicator"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/overdueIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/assignedIndicator"
                android:layout_alignParentStart="true"
                android:text="@string/overdue_indicator"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/ticketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="OPEN"
                android:textColor="@color/badge_info_text"
                android:background="@drawable/badge_bg"
                android:backgroundTint="#333b82f6"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/ticketDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is a description of the ticket. It might be long."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Priority -->
            <TextView
                android:id="@+id/ticketPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@color/text_muted"
                android:layout_marginHorizontal="8dp"/>

            <!-- Date or ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#TK-1001"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
